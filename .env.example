# ─────────────────────────────────────────────────────────────
# URL pública del servidor (issuer OAuth y "resource" del MCP)
# Debe ser EXACTAMENTE la URL por la que los clientes acceden.
# Ej: https://mcp.midominio.com   (en local con túnel: la URL del túnel)
# ─────────────────────────────────────────────────────────────
PUBLIC_URL=https://mcp.midominio.com

# ─────────────────────────────────────────────────────────────
# Conexión a PostgreSQL (host y base FIJOS; el usuario/contraseña
# los pone cada persona al loguearse)
# ─────────────────────────────────────────────────────────────
PGHOST=host.de.tu.base
PGPORT=5432
PGDATABASE=mi_base
# require | no-verify | disable
PGSSLMODE=require

# ─────────────────────────────────────────────────────────────
# Rol "bootstrap" (SOLO para login OAuth de ChatGPT / Claude)
# Debe poder hacer SET ROLE a los usuarios:
#   GRANT usuario1 TO mcp_bootstrap;  (por cada usuario)
# La contraseña de cada persona se valida en el login y NO se guarda;
# las consultas corren como esa persona vía SET ROLE.
# Si sólo vas a usar editores con Basic Auth, podés dejarlo vacío.
# ─────────────────────────────────────────────────────────────
BOOTSTRAP_DB_USER=mcp_bootstrap
BOOTSTRAP_DB_PASSWORD=clave-del-bootstrap

# ─────────────────────────────────────────────────────────────
# Límites de seguridad de las consultas
# ─────────────────────────────────────────────────────────────
STATEMENT_TIMEOUT_MS=8000
MAX_ROWS=1000

# Auditoría de privilegios (mcpYt): baja de fatal a warning el chequeo de
# permisos de escritura del rol conectado. Los chequeos de superuser,
# BYPASSRLS y extensiones de escape (dblink, etc.) nunca se pueden anular.
# ALLOW_WRITABLE_ROLE=false

# ─────────────────────────────────────────────────────────────
# Servidor / tokens
# ─────────────────────────────────────────────────────────────
PORT=3000
# Vida del access token OAuth (segundos)
TOKEN_TTL_SECONDS=3600
# Permitir Basic Auth (usuario:contraseña) en /mcp para editores
ENABLE_BASIC_AUTH=true
# Orígenes CORS permitidos (clientes de navegador)
ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com

# ─────────────────────────────────────────────────────────────
# Sólo para el smoke test manual (test-client.mjs)
# Nunca escribas credenciales dentro de test-client.mjs: está versionado.
# ─────────────────────────────────────────────────────────────
# MCP_TEST_USER=tu_rol_de_postgres
# MCP_TEST_PASSWORD=tu-contraseña
# MCP_URL=http://localhost:3000/mcp
